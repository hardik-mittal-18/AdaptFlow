# ==============================================================================
# AdaptFlow Enterprise MLOps Platform - Environment Variables Template
# ==============================================================================

# Core Application Settings
PORT=3000
NODE_ENV=production
VITE_APP_URL=https://adapt-flow-brown.vercel.app
FRONTEND_URL=https://adapt-flow-brown.vercel.app

# Google Gemini Copilot (Optional AI Assistant)
GEMINI_API_KEY=

# Supabase Auth, PostgreSQL & Storage
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Secret Admin Invite Code (validated server-side for admin self-registration)
ADMIN_INVITE_CODE=ADAPTFLOW_SECRET_ADMIN_2026

# Backend Gateway & ML Inference Service Configuration
VITE_API_URL=https://your-railway-backend.up.railway.app
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_PORT=8000

# MLflow Experiment Tracking & Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ENABLE_TELEMETRY=false

# Monitoring & Alerting
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
SLACK_ALERT_WEBHOOK_URL=
